{
  // StockTracker sync backend — Cloudflare Worker + D1.
  // database_id is a placeholder until `wrangler d1 create stocktracker-sync`
  // prints the real one (setup.ps1 walks through it).
  "name": "stocktracker-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stocktracker-sync",
      "database_id": "cfb5ffca-1a4e-4719-9628-366398c19cef"
    }
  ]
}
